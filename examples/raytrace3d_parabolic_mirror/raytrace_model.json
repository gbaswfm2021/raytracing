      { "id": "fused-silica", "name": "Fused silica (Malitson 1965)", "formula": "sellmeier",
        "B": [0.6961663, 0.4079426, 0.8974794], "C": [0.00467914825849, 0.01351206307396, 97.934002537921],
        "validRangeUm": [0.21, 3.71], "reference": "I. H. Malitson, J. Opt. Soc. Am. 55, 1205-1209 (1965)." }
    ],
    "wavelengths": [ { "id": "d", "label": "d", "lambdaNm": 587.5618, "weight": 1 } ],
    "surfaceProperties": [
      { "id": "silver", "name": "Protected silver", "kind": "mirror", "reflectance": 0.96 },
      { "id": "black", "name": "Black paint", "kind": "absorber" }
    ],
    "objects": [
      { "id": "mirror", "name": "Paraboloid", "kind": "lens", "position": [0, 0, 0], "rotationDeg": [0, 0, 0],
        "material": "fused-silica", "surfaceProperty": "black",
        "lens": { "radius1": -200, "conic1": -1, "radius2": 0, "conic2": 0, "thickness": 8, "diameter": 50 },
        "faceProperties": { "front": "silver" } },
